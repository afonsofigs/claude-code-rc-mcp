# --- Required ---

# Secret used to derive the OAuth client_id / client_secret (any high-entropy string).
# Generate one with: openssl rand -hex 32
MCP_SECRET=

# Public HTTPS URL of this server, used as the OAuth issuer.
SERVER_URL=https://claude-rc-mcp.example.com

# Development server reached over SSH.
SSH_HOST=devserver.example.com
SSH_USER=youruser

# SSH private key CONTENT (the full PEM block, newlines included), not a path.
SSH_PRIVATE_KEY=

# Base directory on the remote server. The `path` input of start_session is
# resolved relative to this.
PROJECTS_BASE_DIR=/home/youruser/projects

# --- Optional ---

# SSH port (default: 22)
# SSH_PORT=22

# Passphrase for the SSH private key, if it is encrypted.
# SSH_PASSPHRASE=

# claude binary on the remote server. Set to an absolute path if `claude` is not
# on the PATH of a non-interactive SSH session (default: claude).
# CLAUDE_BIN=/home/youruser/.local/bin/claude

# If true, sessions spawn on-demand work in isolated git worktrees
# (claude remote-control --spawn worktree). Per-call `worktree` input overrides this.
# SPAWN_WORKTREE=false

# Appended to the system prompt of every conversational session, resumed ones
# included. Interactive widgets (AskUserQuestion) cannot be answered through this
# MCP, so a rule like this one keeps sessions from stalling on them.
# APPEND_SYSTEM_PROMPT="Never use AskUserQuestion or any other interactive widget: they cannot be answered in this session. When you need a decision or clarification, write the questions out in your reply, numbered, with the options and your recommendation, and end the turn to wait for a text answer."

# How long a session that is no longer running stays listed and resumable,
# counted from its last activity (default: 14).
# SESSION_RETENTION_DAYS=14

# Where issued OAuth tokens are persisted (mount a volume here to survive restarts).
# TOKEN_STORE_PATH=/data/oauth-tokens.json

# Server port (default: 3000)
# PORT=3000
