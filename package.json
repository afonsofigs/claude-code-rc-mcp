{
  "name": "claude-code-rc-mcp",
  "version": "1.4.1",
  "description": "Self-hosted MCP server that launches Claude Code Remote Control sessions on a remote dev server over SSH",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js",
    "lint": "eslint .",
    "test": "node --test",
    "verify": "npm run check && npm run lint && npm test",
    "e2e": "node scripts/e2e.mjs"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "remote-control",
    "ssh",
    "model-context-protocol",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.21.0",
    "ssh2": "^1.16.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
